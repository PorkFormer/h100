# 必填：使用原始 Base 和三份原始 Parquet；路径可包含空格。
MODEL_PATH="/data/models/Qwen3-4B-Base"
TRAIN_FILE="/data/dapo_math_17k_train.parquet"
VAL_FILE_1="/data/aime-2024-verl.parquet"
VAL_FILE_2="/data/aime-2025-verl.parquet"
OUTPUT_ROOT="/data/qwen3_4b_reproduction"

# 默认单机 8×80GB；两个实验顺序独占这些 GPU。
CUDA_VISIBLE_DEVICES="0,1,2,3,4,5,6,7"
GPUS_PER_NODE=8
RAY_CPUS=32
RAY_OBJECT_STORE_GB=16
# 修改 RUN_TAG 可创建另一组独立实验；已有目录绝不覆盖或自动恢复。
RUN_TAG="repro_v1"
PROJECT_NAME="qwen3_4b_reproduction"
# 可写、短路径；Ray socket 不能放在很长的输出目录中。
CACHE_ROOT="/tmp/q4repro-cache"

# 仅在已有同版本独立环境时设置；默认使用 setup_env.sh 建立的 .venv。
# PYTHON_BIN="/path/to/python"
# 完整源码包自动找到 ./verl；仓库内自动找到 ../../verl。
# VERL_ROOT="/path/to/verl"
