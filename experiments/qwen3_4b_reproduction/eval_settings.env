# 手动填写新机器/容器内路径。MODEL_PATH、VAL_FILE_1/2、PYTHON_BIN、VERL_ROOT 继承 settings.env。
AMC23_FILE="/data/amc23-test.parquet"
EVAL_DATA="/data/offline-eval/prompts.json"
# 指向训练后完整的 HF safetensors 目录；不能指向 actor 分布式权重目录。
DAPO_HF="/data/checkpoints/dapo-step300-hf"
NCBR_HF="/data/checkpoints/ncbr-step300-hf"
EVAL_OUTPUT="/data/offline-eval/repro_v1"
EVAL_STEP=300
# 留空自动使用至多8张可见卡；如需子集，填写调度器可见范围内的逻辑序号。
# UUID形式的CUDA_VISIBLE_DEVICES由调度器提供，不要把物理卡号填在这里。
EVAL_GPUS=""
